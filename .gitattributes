# Keep line endings LF everywhere — CRLF from Windows autocrlf would break the
# bash hook (.claude/hooks/*.sh), shell scripts, and churn app/index.html diffs.
* text=auto eol=lf

# Explicit for the fragile ones
*.sh  text eol=lf
*.py  text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf

# Build artifacts — regenerated by scripts/build_app.py, never hand-merged.
# -diff keeps `git diff` / log output from dumping 300KB of generated HTML
# (the real diff is always in app/src/*); linguist-generated hides them in
# GitHub PR views. Merge conflicts here: take either side, rebuild.
app/index.html -diff linguist-generated
app/src/embedded-graph.html -diff linguist-generated

# Binaries — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.mp3 binary
*.zip binary
