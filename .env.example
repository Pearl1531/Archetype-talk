# Archetype Talk — example environment file.
#
# Copy to `.env` and fill in only the keys you actually need. `.env` is
# gitignored; this example file is not, so it must never hold a real value.
#
# Most integrations need NOTHING here: Dovetail, Mixpanel, GA4 and Amplitude
# authenticate through your MCP client (OAuth or its own secret store), and the
# browser app works with no keys at all.
#
# For enterprise installs, prefer exporting these in your shell profile or
# pulling them from your OS keychain instead of writing them to a file —
# see docs/SECRETS.md.

# ElevenLabs — optional. Gives personas a voice ([speak] in /persona-talk).
# Without it, persona-voice says so plainly and stops. https://elevenlabs.io
ELEVENLABS_API_KEY=

# Capacities — optional, only for the API path of /source-sync.
# The Markdown-export path needs no key at all.
CAPACITIES_API_TOKEN=
